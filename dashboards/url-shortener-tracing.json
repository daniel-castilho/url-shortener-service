{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request duration p95/p99 (s) — RED",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "p95", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))" },
        { "refId": "p99", "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Error responses (5xx) by window (count)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\"}[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Requests by http_method (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum by (http_method) (rate(http_server_requests_seconds_count[1m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "ID generation + URL retrieval timers (count) — business spans",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "idgen", "expr": "sum(rate(id_generation_duration_seconds_count[1m]))" },
        { "refId": "retr", "expr": "sum(rate(url_retrieval_duration_seconds_count[1m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "text",
      "title": "Tracing backend",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "options": {
        "mode": "markdown",
        "content": "Spans are produced by Spring Boot auto-instrumentation (micrometer-tracing-bridge-otel) and exported via OTLP (management.otlp.tracing.endpoint, default http://localhost:4318) to the OpenTelemetry Collector (`deploy/otel/otel-collector-config.yml`, tail sampling keeps ERROR traces). Connect a Tempo/Jaeger datasource and switch this dashboard's datasource to explore individual traces, trace duration histograms and the service map."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["url-shortener", "tracing"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "URL Shortener — Tracing (RED)",
  "uid": "url-shortener-tracing",
  "version": 1
}