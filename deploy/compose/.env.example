# Template for deploy/compose/.env — copy to .env, chmod 600, and replace every
# CHANGE_ME value. .env is git-ignored and must never be committed.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env && bash bootstrap.sh
#
# ProdConfigValidator (prod profile) aborts the boot if APP_JWT_SECRET or
# OPERATOR_PASSWORD is missing/weak, so the app fails closed on a bad .env.

# --- MongoDB (root bootstrap user + app readWrite user created by mongo-init.js) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_root_password
MONGO_APP_USER=urlshortener
MONGO_APP_PASSWORD=CHANGE_ME_app_password
MONGO_DB=urlshortener

# --- Application (prod profile contract) ---
# >= 32 chars, not the framework default
APP_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
# >= 16 chars; username must not be "operator"/"admin" (ProdConfigValidator)
OPERATOR_USERNAME=metrics-ops
OPERATOR_PASSWORD=CHANGE_ME_at_least_16_characters
# Comma-separated e-mails granted the product ADMIN role
APP_ADMIN_EMAILS=you@example.com
# On-demand TLS ask token for custom domains (empty = feature disabled, safe here)
EDGE_ASK_TOKEN=

# --- Image tag consumed by docker compose (CD pins this per deploy) ---
APP_IMAGE_TAG=prod
# Build arg stamped into /actuator/info build.version (optional)
APP_VERSION=0.0.0-compose

# --- Backup (deploy/compose/backup.env, also git-ignored) ---
# MONGODB_URI=mongodb://urlshortener:CHANGE_ME@127.0.0.1:27017/urlshortener?authSource=urlshortener
# BACKUP_RETENTION_DAYS=30
