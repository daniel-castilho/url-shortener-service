# Systemd TEMPLATE unit for running N instances of the URL Shortener (ADR 0001).
#
# NOTE (Epic 8, ADR 0007): the DEPLOY PLANE is blue-green with concrete units
# (deploy/url-shortener-blue.service :8080, deploy/url-shortener-green.service :8081),
# each with its own jar — deploy.sh/rollback.sh operate on those. This template remains
# for SCALE-OUT beyond the deploy plane (>= 3 instances, runbook §12): add the new
# instance to the nginx upstream (deploy/proxy/nginx.conf) manually.
#
# Instantiate per instance:  sudo systemctl enable --now url-shortener@1 url-shortener@2
# Each instance binds its own SERVER_PORT (8080, 8081, ...) and is listed in the
# nginx upstream (deploy/proxy/nginx.conf) with its own weight, enabling
# canary flips (10 -> 30 -> 100) and rolling restarts with zero downtime.
#
# Per-instance env (optional): /etc/url-shortener/url-shortener@<N>.env overrides
# the shared /etc/url-shortener/url-shortener.env.
#
# Requirements: same as url-shortener.service (Java 25+, jar, Mongo/Redis reachable).
# The service runs as the dedicated user 'urlshortener' for security.

[Unit]
Description=URL Shortener Service (instance %i)
Documentation=https://github.com/daniel-castilho/url-shortener-service
After=network-online.target
Wants=network-online.target
# If MongoDB/Redis run on same host via systemd:
# After=mongodb.service redis.service
# Wants=mongodb.service redis.service
# Start after the base unit's siblings when running a fleet:
# After=url-shortener@1.service

[Service]
Type=notify
User=urlshortener
Group=urlshortener
WorkingDirectory=/opt/url-shortener
EnvironmentFile=-/etc/url-shortener/url-shortener.env
EnvironmentFile=-/etc/url-shortener/url-shortener@%i.env
# Instance port = 8080 + (i - 1): instance 1 -> 8080, 2 -> 8081, ...
ExecStart=/usr/bin/java \
    -XX:+UseZGC \
    -XX:+ZGenerational \
    -Dspring.profiles.active=prod \
    -Dserver.port=808%i \
    -jar /opt/url-shortener/url-shortener.jar
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
# Graceful shutdown: Spring Boot 4 supports graceful shutdown with SIGTERM
# The app will drain in-flight requests during the grace period (see application.yaml)
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening (mirrors url-shortener.service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/url-shortener/logs /var/log/url-shortener
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=url-shortener-%i

[Install]
WantedBy=multi-user.target
